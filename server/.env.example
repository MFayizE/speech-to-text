# Copy to server/.env for local development.
PORT=8080
DATABASE_URL=postgres://stt:stt@localhost:5433/stt
# Set to true for hosted Postgres that needs TLS (Neon, Supabase).
DATABASE_SSL=false

# Gemini Live API key from https://aistudio.google.com/apikey (free tier works).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe-live

# Self-hosted faster-whisper sidecar (docker compose up whisper).
WHISPER_URL=ws://localhost:8001/ws

# Engine used when the client does not pick one: gemini or whisper.
STT_PROVIDER=
